anchor_right = 0.5
offset_left = -300.0
offset_top = 24.0
offset_right = 300.0
offset_bottom = 84.0
grow_horizontal = 2
mouse_filter = 2

[node name="Name" type="Label" parent="RoundHUD/WardenPanel"]
